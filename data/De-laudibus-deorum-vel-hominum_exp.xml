                </l>
                <note target="#seg_Unde_nil_maius_generatur_ipso_1" type="addition"> aquae ex illo <choice>
                        <abbr>qͥ</abbr>
                        <expan>qui</expan>
                    </choice> cuncta <choice>
                        <abbr>tẽperat</abbr>
                        <expan>temperat</expan>
                    </choice>, <choice>
                        <abbr>aqͥ</abbr>
                        <expan>aquae</expan>
                    </choice>
                    <choice>
                        <abbr>uirg̃</abbr>
                        <expan>virginis</expan>
                    </choice> unde <choice>
                        <abbr>genꝰ</abbr>
                        <expan>genus</expan>
                    </choice> ducis <choice>
                        <abbr>qᵘsi</abbr>
                        <expan>quasi</expan>
                    </choice>
                    <choice>
                        <abbr>dic̃</abbr>
                        <expan>dicit</expan>
                    </choice>
                    <choice>
                        <abbr>iouẽ</abbr>
                        <expan>Iovem</expan>
                    </choice>
                    <choice>
                        <abbr>suꝑ</abbr>
                        <expan>super</expan>
                    </choice>
                    <choice>
                        <abbr>om̃ia</abbr>
                        <expan>omnia</expan>
                    </choice> sine <choice>
                        <abbr>cõparatione</abbr>
                        <expan>comparatione</expan>
                    </choice>
                </note>
                <l>
                    <seg xml:id="seg_Unde_nil_maius_generatur_ipso_1"> Unde nihil maius generatur
                        ipso. </seg>
                    <seg type="translation" xml:lang="en">From whom nothing is begotten greater than
                        himself,</seg>
                </l>
                <note target="#seg_simile_1" type="addition">illi</note>
                <l> Nec <choice>
                        <abbr>uig&amp;</abbr>
                        <expan>viget</expan>
                    </choice> quicquam <seg xml:id="seg_simile_1">simile</seg> aut secundum. <seg
                        type="translation" xml:lang="en">nor does anything exist like him or second
                        to him.</seg>
                </l>
                <seg xml:id="seg_y_1">y</seg>
                <note target="#seg_Pallas_1" type="explanation">sapientia</note>
                <l> Proximos illi tamen occupavit <seg xml:id="seg_Pallas_1"><rs key="Pallas"
                            >Pallas</rs></seg> honores. <seg type="translation" xml:lang="en">Yet
                        Pallas has won the honors closest to his own.</seg>
                </l>
                <l> Proeliis audax <choice>
                        <abbr>neq'</abbr>
                        <expan>neque</expan>
                    </choice> te silebo <seg type="translation" xml:lang="en">Nor shall I pass you
                        by in silence, Bacchus, bold in battle,</seg>
                </l>
                <note target="#seg_Liber_1" type="synonym">Bacche</note>
                <note target="#seg_seuis_inimica_uirgo_1" type="explanation">
                    <choice>
                        <abbr>dianã</abbr>
                        <expan>Dianam</expan>
                    </choice>
                    <choice>
                        <abbr>dic̃</abbr>
                        <expan>dicit</expan>
                    </choice>
                    <choice>
                        <abbr>studiosã</abbr>
                        <expan>studiosam</expan>
                    </choice>
                    <choice>
                        <abbr>uenandi </abbr>
                        <expan>venandi</expan>
                    </choice>
                </note>
                <l>
                    <seg xml:id="seg_Liber_1">
                        <rs key="Liber">Liber</rs></seg> et <seg xml:id="seg_seuis_inimica_uirgo_1">
