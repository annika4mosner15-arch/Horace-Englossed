                </l>
                <note target="#seg_Arte_materna_1" type="explanation"> musica scilicet nam filius <choice>
                        <abbr>Calliopẽ</abbr>
                        <expan>Calliopae</expan>
                    </choice>
                    <choice>
                        <abbr>đrͣ</abbr>
                        <expan>dicitur</expan>
                    </choice>
                </note>
                <l>
                    <seg xml:id="seg_Arte_materna_1">
                        <rs key="Arte materna">Arte materna</rs></seg> rapidos <choice>
                        <abbr>morantẽ </abbr>
                        <expan>morantes </expan>
                    </choice>
                    <seg type="translation" xml:lang="en">He who by his mother's art delayed the
                        rapid</seg>
                </l>
                <note target="#seg_lapsus_1" type="synonym">cursus</note>
                <l>
                    <choice>
                        <abbr>Fluminũ</abbr>
                        <expan>Fluminum</expan>
                    </choice>
                    <seg xml:id="seg_lapsus_1">lapsus</seg>
                    <choice>
                        <abbr>celerisq.</abbr>
                        <expan>celerisque</expan>
                    </choice> ventos <seg type="translation" xml:lang="en">winds and the course of
                        the river </seg>
                </l>
                <note target="#seg_Blandũ_1" type="addition">propter</note>
                <note target="#seg_auritas_1" type="explanation">sensum audiendi habentes</note>
                <note target="#seg_ducere_1" type="addition">oblectare</note>
                <l>
                    <seg xml:id="seg_Blandũ_1"><choice>
                            <abbr>Blandũ</abbr>
                            <expan>Blandum</expan>
                        </choice></seg> et <seg xml:id="seg_auritas_1">auritas</seg>
                    <choice>
                        <abbr>fidibꝯ</abbr>
                        <expan>fidibus</expan>
                    </choice> canoris <seg xml:id="seg_ducere_1">ducere</seg> quercus. <seg
                        type="translation" xml:lang="en">and was pervuasive enough to lead the
                        listening oaks with his melodious strings.</seg>
                </l>
                <l> Quid prius <choice>
                        <abbr>dicã</abbr>
                        <expan>dicam</expan>
                    </choice> solitis <name key="parentum"><choice>
                            <abbr>parentũ</abbr>
                            <expan>parentum</expan>
                        </choice></name>
                    <seg type="translation" xml:lang="en">What should I sing before the customary
                        praises of the Father?</seg>
                </l>
                <l>
                    <choice>
                        <abbr>Laudibꝯ</abbr>
                        <expan>Laudibus</expan>
                    </choice> qui res <choice>
                        <abbr>hominũ</abbr>
                        <expan>hominum</expan>
                    </choice> ac <choice>
                        <abbr>deoꝵ</abbr>
                        <expan>deorum</expan>
                    </choice>
                    <seg type="translation" xml:lang="en">Who rules the affairs of men and
                        gods,</seg>
                </l>
                <note target="#seg_temperat_1" type="addition"> distinguit dimensio </note>
                <l> Qui mare et terras variisque <seg xml:id="seg_temperat_1">temperat</seg> horis
                        <seg type="translation" xml:lang="en">who rules the sea, the land, and the
