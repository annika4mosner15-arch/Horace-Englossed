                </l>
                <note target="#seg_nec_te_1">scilicet silebo</note>
                <note target="#seg_certa_1" type="synonym">inevitabili</note>
                <note>o</note>
                <note target="#seg_Phoebe_1" type="explanation"><choice>
                        <abbr>apolline</abbr>
                        <expan>Apollinem</expan>
                    </choice>
                    <choice>
                        <abbr>dic̃</abbr>
                        <expan>dicit</expan>
                    </choice></note>
                <l> Beluis nec te metuende certa <seg xml:id="seg_Phoebe_1">
                        <rs key="Phoebus">Phoebe </rs></seg> sagitta. <seg type="translation"
                        xml:lang="en">nor you, Apollo, to be feared for your unerring arrow.</seg>
                </l>
                <note target="#seg_alciden_1" type="explanation"><choice>
                        <abbr>herculẽ</abbr>
                        <expan>Herculem</expan>
                    </choice></note>
                <l>
                    <metamark><seg xml:id="seg_tricolon_1">∵</seg></metamark> Dicam et <seg
                        xml:id="seg_alciden_1">
                        <rs key="Alcides">Alciden </rs></seg>, <seg xml:id="seg_puerosqe_ledae_1">
                        <rs key="pueros Ledae">puerosque Ledae </rs></seg>. <seg type="translation"
                        xml:lang="en">I will sing of Alcides, and the sons of Leda.</seg>
                </l>
                <note target="#seg_pueros_q̨_ledȩ_1" type="explanation"><choice>
                        <abbr>castorẽ</abbr>
                        <expan>Castorem</expan>
                    </choice>
                    <choice>
                        <abbr>pollucẽ</abbr>
                        <expan>Pollucem</expan>
                    </choice></note>
                <l> Hunc equis illum superare pugnis <seg type="translation" xml:lang="en">One
