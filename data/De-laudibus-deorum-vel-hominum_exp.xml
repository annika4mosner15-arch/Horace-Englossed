            <editorialDecl>
                <interpretation>
                    <!-- most common Latin abbreviations of this manuscript listed -->
                    <p>The following abbreviations occur in the manuscript and expanded in the
                        transcription: ꝓ = pro; ꝑ = per/par; ꝗ = qui; ꝙ = quod; ÷ = est; ⁊ =
                        et/etiam; ꝰ = us; ꝯ = con; ꝵ = rum; ũ = um/us; ã = am/as; ẽ = em/es.</p>
                </interpretation>
            </editorialDecl>
