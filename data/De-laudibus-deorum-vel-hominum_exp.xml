    <text>
        <body>
            <!-- marginal glosses on the left side of the manuscript page -->
            <ab>
                <metamark>Ø</metamark>
                <note target="#seg_Ø_1" type="commentary">
                    <p> In hac ode <choice>
                            <abbr>uelut</abbr>
                            <expan>velut</expan>
                        </choice>
                        <choice>
                            <abbr>ꝓ</abbr>
                            <expan>pro</expan>
                        </choice> sitio <choice>
                            <abbr>ẽ</abbr>
                            <expan>est</expan>
                        </choice> cuiusdam incerti carminis. Nam dubitat <choice>
                            <abbr>ꝗd</abbr>
                            <expan>quid</expan>
                        </choice> primum <choice>
                            <abbr>ꝗd</abbr>
                            <expan>quid</expan>
                        </choice> potissimum dicat. Utrum caelestium deorum an <choice>
                            <abbr>romanorum</abbr>
                            <expan>Romanorum</expan>
                        </choice> deorum &amp; fortium ducum. Omnis tamen laudat cum se fingit
                        ancipitem. Peroratoriam paralexin. <choice>
                            <abbr>Verum</abbr>
                            <expan>Verum</expan>
                        </choice> meliori intentum iam Augusti laudem extendit. <choice>
                            <abbr>ꝙ</abbr>
                            <expan>Quod</expan>
                        </choice> secundum <choice>
                            <abbr>Iouem</abbr>
                            <expan>Iovem</expan>
                        </choice> vult esse interris. Ordo <choice>
                            <abbr>÷</abbr>
                            <expan>est</expan>
                        </choice> o Clio quem <choice>
                            <abbr>uirum</abbr>
                            <expan>virum</expan>
                        </choice> aut quem heroam sumis celebrare tibia aut acrilira. </p>
                </note>
                <metamark>y</metamark>
                <note target="seg_y_1" type="commentary">
                    <p>
                        <choice>
                            <abbr>ꝓximã</abbr>
                            <expan>Proximam</expan>
                        </choice>
                        <choice>
                            <abbr>Iouis</abbr>
                            <expan>Iovis</expan>
                        </choice> honori Minervam, <choice>
                            <abbr>ħ</abbr>
                            <expan>hoc</expan>
                        </choice>
                        <choice>
                            <abbr>ẽ</abbr>
                            <expan>est</expan>
                        </choice> virtutem et sapientiam deo <choice>
                            <abbr>uicinam</abbr>
                            <expan>vicinam</expan>
                        </choice>, unde nulla quaestio <choice>
                            <abbr>÷</abbr>
                            <expan>est</expan>
                        </choice>. Cum <choice>
                            <abbr>supra</abbr>
                            <expan>supra</expan>
                        </choice> dixerit nil <choice>
                            <abbr>Iouis</abbr>
                            <expan>Iovis</expan>
                        </choice> simile et secundum et in sequenti Minervam posuit. </p>
                </note>
                <metamark>∵</metamark>
                <note target="seg_∵_1" type="commentary">
                    <p> Castorem et Pollucem Ledae filios. Amatorem equorum Castorem dicit ut <choice>
                            <abbr>÷</abbr>
                            <expan>est</expan>
                        </choice> talis <choice>
                            <abbr>amrclei</abbr>
                            <expan>amoris</expan>
                        </choice> domitus Pollucis habens. Pollucem <choice>
                            <abbr>uero</abbr>
                            <expan>vero</expan>
                        </choice> pugnis non bellis valentem ab eo quod pugil fuerit. Ergo pugnos
                        dicit ut tertium inveniatur in genere. </p>
                </note>
            </ab>

            <!-- beginning of current ode (carmen 1,12) -->
            <fw><hi>DE LAUDIBUS DEORUM VEL HOMINUM.</hi></fw>
            <!-- main text of ode including interlinear glosses -->
            <ab>
                <l>
                    <metamark><seg xml:id="seg_Ø_1">Ø</seg></metamark> Quem <choice>
                        <abbr>uirũ</abbr>
                        <expan>virum</expan>
                    </choice> aut heroam lyra <choice>
                        <abbr>uel</abbr>
                        <expan>vel</expan>
                    </choice> acri <seg type="translation" xml:lang="en">What man or what hero with
                        the lyre or the shrill</seg>
                </l>
                <note target="#seg_sumis_1" type="addition"><choice>
                        <abbr>ꝯtendis</abbr>
                        <expan>contendis</expan>
                    </choice></note>
                <note target="#seg_clyo_1" type="explanation">una ex <choice>
                        <abbr>uiiiii</abbr>
                        <expan>novem</expan>
                    </choice> musis</note>
                <l> Tibia <seg xml:id="seg_sumis_1">sumis</seg> celebrare <seg xml:id="seg_clyo_1">
                        <name key="Clio"><choice>
                                <abbr>clyo</abbr>
                                <expan>Clio</expan>
                            </choice></name>
                    </seg>: <seg type="translation" xml:lang="en">flute do you choose to celebrate,
                        Clio?</seg>
                </l>
                <note>sumis celebrare</note>
                <l>
                    <choice>
                        <abbr>Quẽ </abbr>
                        <expan>Quem </expan>
                    </choice>
                    <choice>
                        <abbr>deũ</abbr>
                        <expan>deum</expan>
                    </choice>, cuius retinet iocosa nomen imago <seg type="translation"
                        xml:lang="en">Which god, whose name will the playful echo repeat</seg>
                </l>
                <note target="#seg_heliconis_oris_1" type="explanation"> in Parnaso monte musis <choice>
                        <abbr>ꝯsecrato </abbr>
                        <expan>consecrato </expan>
                    </choice></note>
                <l> Aut in <choice>
                        <abbr>umbrosis</abbr>
                        <expan>umbrosis</expan>
                    </choice>
                    <seg xml:id="seg_heliconis_oris_1">
                        <rs key="Helicon">Heliconis oris</rs>
                    </seg>
                    <seg type="translation" xml:lang="en">either on the shady borders of
                        Helicon?</seg>
                </l>
                <note target="#seg_aut_super_pindo_1" type="explanation"> mons Thraciae in <choice>
                        <abbr>qͦ </abbr>
                        <expan>quo </expan>
                    </choice>
                    <choice>
                        <abbr> orpheuꝰ</abbr>
                        <expan>Orpheus </expan>
                    </choice> cecinit </note>
                <l>
                    <seg xml:id="seg_aut_super_pindo_1">Aut <choice>
                            <abbr>suꝑ </abbr>
                            <expan>super </expan>
                        </choice>
                        <name key="Pindo">Pindo</name></seg>. <seg xml:id="seg_gelidoue_in_haemo_1"><choice>
                            <abbr>gelidoue</abbr>
                            <expan>gelidove</expan>
                        </choice> in <name key="Haemus"><choice>
                                <abbr>hȩmo </abbr>
                                <expan>haemo </expan>
                            </choice></name>
                    </seg>. <seg type="translation" xml:lang="en">Or upon the heights of Pindus, or
                        on cold Haemus,</seg>
                </l>
                <note target="#seg_gelidoue_in_haemo_1" type="explanation"> mons <choice>
                        <abbr>thessaliȩ</abbr>
                        <expan>Thessaliae</expan>
                    </choice> haemo </note>
                <note target="#seg_Unde_uocalẽ_temere_in_secutę_Orphea_siluȩ_1" type="explanation">
                    vocales <choice>
                        <abbr>om̃s </abbr>
                        <expan>omnes </expan>
                    </choice>
                    <choice>
                        <abbr>sũme </abbr>
                        <expan>sumptae </expan>
                    </choice>
                    <choice>
                        <abbr>uoces</abbr>
                        <expan>voces</expan>
                    </choice>
                    <choice>
                        <abbr>dnr̃ </abbr>
                        <expan>dicuntur </expan>
                    </choice>
                </note>
                <l>
                    <seg xml:id="seg_Unde_uocalem_temere_insecutae_Orphea_silvae_1"> Unde <choice>
                            <abbr>uocalẽ </abbr>
                            <expan>vocalem </expan>
                        </choice> temere <choice>
                            <abbr>insecutę </abbr>
                            <expan>insecutae </expan>
                        </choice>
                        <name key="Orpheus">Orphea</name><choice>
                            <abbr> silvȩ</abbr>
                            <expan> silvae</expan>
                        </choice>. </seg>
                    <seg type="translation" xml:lang="en">where the hurrying woods followed the
