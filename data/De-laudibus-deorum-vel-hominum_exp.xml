                </l>
            </ab>
            <!-- new page of manuscript (folio 8r), main text of ode resumes here with interlinear glosses -->
            <pb n="8r"/>
            <ab>
                <l>
                    <choice>
                        <abbr>Nobilẽ</abbr>
                        <expan>Nobilem</expan>
                    </choice> quorum simul alba nautis Stella refulsit. <seg type="translation"
